# Production deploy-д зориулсан жишээ env файл — docker-compose.yml энэ файлыг
# `--env-file` аргументаар уншина. ХЭРЭГЛЭХИЙН ӨМНӨ:
#   cp .env.production.example .env.production
# дараа нь доорх бүх ${VAR}-ийг бодит утгаар бөглөнө. `.env.production`-ыг ЗААВАЛ
# .gitignore-д байлгаж git рүү commit хийхгүй (нууц түлхүүрүүд агуулна).
#
# Бүрэн заавар: doc-ийн эцэст ("Deploy алхмууд") хэсгийг үзнэ үү.

# ============ 1. ЗААВАЛ шинэ санамсаргүй утгаар солих (dev/test утга ХЭРЭГЛЭХГҮЙ) ============
# Үүсгэх арга (PowerShell): -join ((48..57)+(97..102)|Get-Random -Count 64|%{[char]$_})
# Эсвэл (Git Bash): openssl rand -hex 32

# JWT access token гарын үсэг (алдагдвал бүх хэрэглэгч дахин нэвтрэх шаардлагатай)
JWT_ACCESS_SECRET=

# Cookie (refresh token) гарын үсэг
COOKIE_SECRET=

# Postgres нууц үг (шинэ, урт, санамсаргүй)
POSTGRES_PASSWORD=

# MinIO (S3-тэй нийцтэй file storage) root хэрэглэгч/нууц үг
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# worker/backend хоорондын Haptic Score callback-ийг баталгаажуулах shared secret
HAPTIC_CALLBACK_SECRET=

# Payment webhook (одоогоор БИДНИЙ ӨӨРСДИЙН sandbox/demo дуудлагад ашиглагддаг,
# жинхэнэ QPay/SocialPay мерчант API холбогдоогүй — см. payment-webhook.guard.ts)
PAYMENT_WEBHOOK_SECRET=

# Хэрэглэгчийн сонсголын профайл (эрүүл мэндийн мэдээлэл) шифрлэх түлхүүр —
# хамгийн өндөр эрсдэлтэй, dev утгыг ХЭЗЭЭ Ч production-д ашиглахгүй
HEARING_PROFILE_ENC_KEY=

# ============ 2. Домэйн/CORS ============
# Frontend-ийн жинхэнэ нийтийн URL (Vercel дээр байрлуулсан бол Vercel-ийн домэйн,
# өөрийн VPS дээр web service ажиллуулж байгаа бол өөрийн домэйн)
#
# ⚠️ Энэ утга нь frontend-ийн build ARG `NEXT_PUBLIC_WS_URL`-д ч дамждаг
# (docker-compose.yml → web.build.args). socket.io нь Next.js-ийн rewrites-аар
# ДАМЖДАГГҮЙ, хөтчөөс шууд залгадаг тул буруу/хоосон бол QR-ээр утас холбох,
# төхөөрөмжийн sync, haptic урсгал бүгд чимээгүй унана (алдаа ч харагдахгүй).
# Өөрчилсний дараа `web` service-ийг ЗААВАЛ дахин build хийнэ (--build), учир нь
# NEXT_PUBLIC_* нь runtime биш, build-ийн үед bundle дотор шатаагддаг.
PUBLIC_ORIGIN=https://таны-домэйн.com

# nginx/TLS override (docker-compose.tls.yml) ашиглах бол PUBLIC_DOMAIN бас хэрэгтэй
# (protocol/схемгүй, зөвхөн хост нэр)
PUBLIC_DOMAIN=таны-домэйн.com

# Let's Encrypt сертификатын мэдэгдэл имэйл (scripts/init-tls.sh-д ашиглана)
LETSENCRYPT_EMAIL=

# S3/MinIO файлуудын нийтэд харагдах URL — VPS дээр MinIO шууд ашиглаж байгаа бол
# https://таны-домэйн.com/media (nginx location тохируулсны дараа), эсвэл гадаад
# S3-compatible үйлчилгээ ашиглаж байвал тэдний өгсөн public endpoint.
S3_PUBLIC_URL=https://таны-домэйн.com/media

# ============ 3. Гадаад үйлчилгээний түлхүүрүүд (сонголттой) ============
# Байхгүй бол зөвхөн тухайн ганц feature идэвхгүй болно, систем унахгүй.

# Jamendo (Creative Commons дууны сан импорт) — https://developer.jamendo.com/v3.0
JAMENDO_CLIENT_ID=

# Free Music Archive импорт — https://freemusicarchive.org/api
FMA_API_KEY=

# Google OAuth (Google-ээр нэвтрэх) — https://console.cloud.google.com/apis/credentials
# ЗААВАЛ frontend-ийн NEXT_PUBLIC_GOOGLE_CLIENT_ID-тэй ИЖИЛ байх ёстой (доор тайлбарласан)
GOOGLE_CLIENT_ID=

# Sentry error tracking — https://sentry.io
SENTRY_DSN=

# ============ 4. Frontend-only (Vercel дээр Vercel Dashboard-ын Environment
#    Variables хэсэгт тохируулна, энэ файлд биш) ============
# NEXT_PUBLIC_API_URL=https://таны-backend-домэйн.com/api
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=<GOOGLE_CLIENT_ID-тэй ИЖИЛ утга>
