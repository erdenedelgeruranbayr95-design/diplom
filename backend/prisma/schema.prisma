generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ROOT нь ADMIN-аас ДЭЭР зэрэглэлтэй (систем эзэмшигч). Эрхийн шатлалыг
// `common/guards/roles.guard.ts` нэг газар шийднэ — controller бүрийн @Roles()
// жагсаалтад ROOT-ыг нэмж бичих шаардлагагүй.
// Бусад дүр (USER · PARENT · THERAPIST · ADMIN) огт өөрчлөгдөөгүй.
enum Role {
  ROOT
  ADMIN
  CURATOR
  MODERATOR
  THERAPIST
  USER
  PARENT
}

enum SessionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum QRStatus {
  PENDING
  CONNECTED
  EXPIRED
}

enum UserStatus {
  ACTIVE
  BANNED
}

enum TrackAction {
  LIKE
  SAVE
}

enum PaymentStatus {
  SUCCESS
  FAILED
  PENDING
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  EXPIRED
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum SongAnalysisStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

// Дипломын хамгийн эрсдэлтэй зүйл (ROADMAP-7-PHASES.md): зохиогчийн эрхийн
// нэхэмжлэл ирвэл бүтээгдэхүүнийг зогсооно. Тиймээс лиценз ЗААВАЛ талбар,
// upload-ын үед сервер талд шалгана (см. songs.controller.ts).
enum SongLicense {
  CC_BY
  CC_BY_SA
  CC_BY_NC
  CC0
  ORIGINAL // Хэрэглэгч өөрөө зохиосон/эзэмшигч
  LICENSED // Тусдаа гэрээ/лиценз баримттай (licenseSrc-д тайлбарлана)
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         Role       @default(USER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  lastLoginAt  DateTime?

  // Профайлын тохиргоо (ProfileView). `hearingProfile` нь ЭМЗЭГ эрүүл мэндийн
  // мэдээлэл тул заавал биш — хэрэглэгч өөрөө хүсвэл л бөглөнө (§14).
  avatarColor    String?
  hearingProfile String?

  // Хурдан унших зориулалттай хуулбарласан талбарууд (denormalized cache) —
  // `Subscription`-той үргэлж хамт update хийгдэнэ (жинхэнэ мэдээлэл Subscription
  // моделд байна). JWT/session-д дахин query хийхгүйгээр PRO эрхийг шалгахад ашиглана.
  subActive Boolean   @default(false)
  subPlan   String?
  subSince  DateTime?
  subRenews DateTime?

  subscription  Subscription?
  refreshTokens RefreshToken[]
  notifications NotificationRead[]

  songs                           Song[]
  therapySessionsAsTherapist      TherapySession[]      @relation("TherapistSessions")
  therapySessionsAsPatient        TherapySession[]      @relation("PatientSessions")
  progress                        Progress[]
  qrSessions                      QRSession[]
  therapistAssignmentsAsTherapist TherapistAssignment[] @relation("TherapistOf")
  therapistAssignmentsAsPatient   TherapistAssignment[] @relation("PatientOf")
  parentLinksAsParent             ParentLink[]          @relation("ParentOf")
  parentLinksAsChild              ParentLink[]          @relation("ChildOf")
  listenHistory                   ListenHistory[]

  sensoryProfile  SensoryProfile?
  trackActions    UserTrackAction[]
  playlists       Playlist[]
  payments        Payment[]
  auditLogs       AuditLog[]        @relation("AuditActor")
  reportsFiled    Report[]          @relation("ReportedBy")
  reportsResolved Report[]          @relation("ReportResolvedBy")
}

// Админ/ROOT-ийн хийсэн бүх өөрчлөх (mutating) үйлдлийн мөрдөгдөх бүртгэл —
// `common/interceptors/audit-log.interceptor.ts` нь бүх PATCH/POST/DELETE route дээр
// (@Roles шаардсан, GET биш) автоматаар бичнэ.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  actor     User     @relation("AuditActor", fields: [actorId], references: [id], onDelete: Cascade)
  action    String // "PATCH /users/:id/status" гэх мэт route дүрслэл
  target    String? // нөлөөлсөн объектын ID (жишээ: target userId)
  meta      Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([createdAt])
}

// Хэрэглэгчийн мэдүүлсэн тохирохгүй контент/зөрчлийн бүртгэл (дуу, хэрэглэгч гм).
model Report {
  id           String       @id @default(cuid())
  reporterId   String
  reporter     User         @relation("ReportedBy", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType   String // "song" | "user" гэх мэт
  targetId     String
  reason       String
  status       ReportStatus @default(OPEN)
  resolvedById String?
  resolvedBy   User?        @relation("ReportResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt   DateTime?
  createdAt    DateTime     @default(now())

  @@index([status, createdAt])
}

// Калибровкийн үр дүн (Calibrate → useCalibrationFlow). Хэрэглэгч тутамд ганц мөр —
// төхөөрөмж/browser солиход ижил тохиргоо гарахын тулд localStorage-аас энд шилжив.
model SensoryProfile {
  userId     String   @id
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vibLevel   Int      @default(1)
  lightLevel Int      @default(1)
  bands      Json // { bass: boolean, mid: boolean, high: boolean }
  deviceMap  Json? // { bass: "left" | "right" | ... } зэрэг биеийн байрлал-оноолт
  calibrated Boolean  @default(false)
  updatedAt  DateTime @updatedAt
}

// Дуртай/хадгалсан дуу. Зөвхөн backend-д байршсан Song-той ажиллана (static каталог
// эсвэл IndexedDB-ийн admin-нэмсэн дуунуудад ажиллахгүй — тэдгээр нь клиент талын
// синтетик ID-тэй тул FK холбоо байгуулах боломжгүй).
model UserTrackAction {
  userId    String
  songId    String
  action    TrackAction
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  song      Song        @relation(fields: [songId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@id([userId, songId, action])
  @@index([userId, action])
}

model Playlist {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime        @default(now())
  tracks    PlaylistTrack[]

  @@index([userId])
}

model PlaylistTrack {
  id         String   @id @default(cuid())
  playlistId String
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  songId     String
  song       Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  position   Int
  addedAt    DateTime @default(now())

  @@unique([playlistId, songId])
  @@index([playlistId, position])
}

model Payment {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      String
  currency    String        @default("MNT")
  method      String
  status      PaymentStatus @default(SUCCESS)
  providerRef String?
  plan        String?
  createdAt   DateTime      @default(now())

  // `providerRef` (webhook-ийн provider талын гүйлгээний ID) NULL-гүй үед DB
  // түвшинд НЭГ УДАА л бичигдэхийг баталгаажуулна — payments.service.ts-ийн
  // `findFirst` шалгалт (race window-той) дангаараа хангалтгүй, хоёр webhook
  // нэгэн зэрэг ирвэл энэ unique constraint нь давхар мөр бичихээс сэргийлнэ
  // (transaction нь unique violation-оор бүтэлгүйтнэ, давхар PRO төлбөр DB-д
  // бичигдэхгүй).
  @@unique([providerRef])
  @@index([userId, createdAt])
}

// Хэрэглэгч тутамд ганц идэвхтэй захиалга (одоогийн статус) — түүхэн бүх төлбөрийн
// гүйлгээ `Payment`-д хадгалагдана, харин "одоо PRO эсэх" гэдгийг энд нэг мөрөөр
// хөтөлнө. QPay/SocialPay-ийн webhook callback үүнийг шинэчилнэ (payments.service.ts).
// `User.subActive/subPlan/...` талбарууд үргэлж энэ моделтой синхрон явна (§7 тайлбар харна уу).
model Subscription {
  id          String             @id @default(cuid())
  userId      String             @unique
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider    String // "socialpay-demo" | "qpay" гэх мэт
  providerRef String? // Provider талын захиалга/invoice ID — webhook-ийг дахин ирэхэд idempotency шалгахад ашиглана
  plan        String
  status      SubscriptionStatus @default(ACTIVE)
  renewsAt    DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([provider, providerRef])
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model TherapistAssignment {
  id          String   @id @default(cuid())
  therapistId String
  userId      String
  therapist   User     @relation("TherapistOf", fields: [therapistId], references: [id], onDelete: Cascade)
  patient     User     @relation("PatientOf", fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([therapistId, userId])
  @@index([userId])
}

model ParentLink {
  id          String   @id @default(cuid())
  parentId    String
  childUserId String
  parent      User     @relation("ParentOf", fields: [parentId], references: [id], onDelete: Cascade)
  child       User     @relation("ChildOf", fields: [childUserId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([parentId, childUserId])
  @@index([childUserId])
}

// Монгол дуучдын каталог — Song.artist (чөлөөт текст) -ээс тусад нь, бодит "дуучны хуудас"
// (танилцуулга, карьер, зураг) харуулах зорилготой. Хуучин Song.artist string талбарыг
// устгаагүй (одоо байгаа мөрүүд болон backend-жихгүй static frontend catalog-тай нийцтэй
// байлгах "legacy fallback" зорилготой) — зөвхөн artistId нэмж, аль болох Song.artist-ийг
// ч бөглөнө (denormalized, жагсаалт render хийхэд join хийхгүйгээр шууд харуулах боломж).
model Artist {
  id         String   @id @default(cuid())
  name       String   @unique
  bio        String?
  careerInfo String?
  photoUrl   String?
  createdAt  DateTime @default(now())

  songs Song[]
}

model Song {
  id          String   @id @default(cuid())
  title       String
  artist      String?
  artistId    String?
  artistRef   Artist?  @relation(fields: [artistId], references: [id], onDelete: SetNull)
  genre       String?
  description String?
  // Уг үг (lyrics) — Үе шат 6 хүртээмжийн шаардлага: сонсголын бэрхшээлтэй хэрэглэгч
  // хөгжмийн агуулгыг текстээр унших боломжтой байх ёстой. LRC-төстэй энгийн формат:
  // мөр бүр `[mm:ss.xx] текст` (цаг тэмдэглэгээгүй мөр ч бас зөвшөөрнө — тухайн үед
  // цаг тэмдэглэгээгүйгээр л, гэхдээ бүхэлдээ харагдана). Заавал биш талбар.
  lyrics      String?
  releaseYear Int?
  coverUrl    String?
  featured    Boolean  @default(false)
  fileUrl     String
  duration    Int?
  bpm         Int?
  uploadedBy  String
  uploader    User     @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  // ---- Лиценз (заавал) + нийтлэлийн төлөв (Үе шат 5) ----
  license     SongLicense?
  licenseSrc  String? // Гэрээ/эх сурвалжийн холбоос эсвэл тайлбар (LICENSED үед ялангуяа чухал)
  published   Boolean      @default(false)
  publishedAt DateTime?
  jamendoId   String? // Jamendo-с импортолсон бол эх track ID (давхар импортоос сэргийлнэ)

  // ---- Presigned S3 upload баталгаажуулалт (Үе шат 5) ----
  // Клиент presigned URL авч, MinIO руу шууд PUT хийгээд `confirm`-оор мэдэгдэнэ.
  // uploadConfirmed=false үед файл MinIO-д байгаа ч Song жагсаалтад (list/featured/...) гарахгүй.
  uploadConfirmed Boolean @default(true) // presigned бус (legacy multer / sourceUrl) upload-д шууд true

  // ---- client-side анализын үр дүн (backend зөвхөн хадгална, тооцоолохгүй) ----
  analyzedBpm    Int?
  beatCount      Int?
  beatTimestamps Json?
  rms            Float?
  peak           Float?
  bassEnergy     Float?
  midEnergy      Float?
  trebleEnergy   Float?
  waveformPeaks  Json?
  analyzedAt     DateTime?

  // ---- Haptic Score (Python worker: librosa STFT→8 бүс, onset, beat, chroma) ----
  // `fileHash` нь idempotency LOOKUP түлхүүр — ижил файлыг өөр хэрэглэгч/өөр Song мөрөөр
  // 2 дахь удаа upload хийхэд worker дахин задлахгүй, өмнөх Score-г л дахин холбоно.
  // ЗОРИУДААР unique биш: хэд хэдэн Song мөр ижил fileHash-тай байж болно (өөр хэрэглэгч
  // яг ижил mp3 upload хийвэл), unique constraint энэ тохиолдолд update-ийг эвдэнэ.
  fileHash       String?
  scoreUrl       String?
  analysisStatus SongAnalysisStatus @default(PENDING)
  analysisError  String?
  musicalKey     String?

  // ---- HLS/AAC хөрвүүлэлт + ковер боловсруулалт (Үе шат 5, worker ffmpeg/Pillow) ----
  // Заавал биш баяжуулалт — hlsUrl null бол Player эх fileUrl-ээр (mp3/wav) тоглуулна.
  hlsUrl         String?
  coverThumbUrl  String? // 96×96 WebP — жагсаалт/карт
  coverMediumUrl String? // 400×400 WebP — Player дэлгэц
  coverLargeUrl  String? // 1200×1200 WebP — дэлгэрэнгүй/дэлгэц дүүргэх

  sessions        TherapySession[]
  listenHistory   ListenHistory[]
  trackActions    UserTrackAction[]
  playlistEntries PlaylistTrack[]

  @@index([uploadedBy])
  @@index([artistId])
  @@index([fileHash])
  @@index([published])
}

model ListenHistory {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  songId          String
  song            Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  playedAt        DateTime @default(now())
  durationMs      Int?
  bpm             Int?
  visualizerStyle String?
  vibrations      Boolean? // тухайн сонсголд чичиргээ асаалттай байсан эсэх
  device          String? // "phone" | "gamepad" | "ble-vest" | null (зөвхөн дэлгэц)

  @@index([userId, playedAt])
  @@index([songId])
}

model TherapySession {
  id          String        @id @default(cuid())
  therapistId String
  therapist   User          @relation("TherapistSessions", fields: [therapistId], references: [id], onDelete: Cascade)
  userId      String
  patient     User          @relation("PatientSessions", fields: [userId], references: [id], onDelete: Cascade)
  songId      String?
  song        Song?         @relation(fields: [songId], references: [id], onDelete: SetNull)
  notes       String?
  status      SessionStatus @default(SCHEDULED)
  scheduledAt DateTime?
  completedAt DateTime?
  createdAt   DateTime      @default(now())

  progress Progress[]

  @@index([therapistId])
  @@index([userId])
}

model Progress {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  therapySessionId String?
  session          TherapySession? @relation(fields: [therapySessionId], references: [id], onDelete: SetNull)
  completionPct    Int?
  engagementScore  Int?
  recordedAt       DateTime        @default(now())

  @@index([userId])
  @@index([therapySessionId])
}

// Системийн мэдэгдэл. `userId = null` бол BROADCAST — бүх хэрэглэгчид харагдана
// (админы "Зарлал"). Урьд нь энэ нь localStorage дээр байсан тул зөвхөн зарлал
// илгээсэн админы өөрийнх нь browser-т хүрдэг байв.
model Notification {
  id        String   @id @default(cuid())
  userId    String? // null = broadcast
  text      String
  icon      String   @default("🎵")
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

// Хэрэглэгч мэдэгдлээ хамгийн сүүлд хэзээ уншсан бэ (хонхны "шинэ" тоолуурт).
model NotificationRead {
  userId String   @id
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt DateTime @default(now())
}

model QRSession {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    QRStatus @default(PENDING)
  expiresAt DateTime
  createdAt DateTime @default(now())

  desktopSocketId String?
  phoneSocketId   String?

  @@index([userId])
}
