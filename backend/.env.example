DATABASE_URL=postgresql://medreh:medreh_dev_pw@localhost:5434/medreh?schema=public
# АНХААРУУЛГА: доорх бүх "change_me" утгыг production-д ЗААВАЛ жинхэнэ, санамсаргүй
# үүсгэсэн (жиш. `openssl rand -base64 48`) нууц үгээр солих ёстой. Эдгээрийг
# .env файлд ХЭЗЭЭ Ч git-д commit хийхгүй (см. docs/PRODUCTION-DEPLOYMENT-PLAN.md).
JWT_ACCESS_SECRET=change_me
COOKIE_SECRET=change_me
# Next.js frontend нь 3001 дээр ажилладаг (docs/FRONTEND-PHASES.md Хавсралт А).
CORS_ORIGIN=http://localhost:3001
PORT=3000
REDIS_URL=redis://localhost:6379
HAPTIC_CALLBACK_SECRET=change_me
# QPay/SocialPay webhook (эсвэл тэдгээрийн sandbox) callback-ийг баталгаажуулах
# shared secret (см. src/payments/payment-webhook.guard.ts). Жинхэнэ мерчант
# рүү шилжихдээ provider тус бүрийн жинхэнэ signature механизмаар СОЛИХ ёстой.
PAYMENT_WEBHOOK_SECRET=change_me

# --- Stripe (сар бүр сунгагдах PRO захиалга) ---------------------------------
# Гурвуулаа бөглөгдсөн үед л төлбөр идэвхжинэ. Дутуу бол апп ХЭВИЙН асна —
# зөвхөн `GET /api/payments/config` нь `enabled: false` буцааж, клиент тал
# төлбөрийн товчоо нуух эсвэл "түр боломжгүй" гэж харуулна (src/payments/stripe.service.ts).
#
# ⚠️ `sk_test_...` бол ТЕСТ горим — бодит карт татагдахгүй, Stripe-ийн тест карт
#    (4242 4242 4242 4242, ирээдүйн огноо, ямар ч CVC) ажиллана. Дипломын
#    хамгаалалтад энэ горимыг ашиглана. `sk_live_...` руу шилжвэл БОДИТ мөнгө
#    татагдана.
# ⚠️ Энэ түлхүүр НУУЦ — .env нь git-д ОРОХГҮЙ (.gitignore). Задарвал Stripe
#    Dashboard-аас нэн даруй roll хийнэ.
STRIPE_SECRET_KEY=
# Сар бүр давтагдах Price-ийн ID (Stripe Dashboard → Product → Pricing).
# Валют MNT байж болно (Stripe-ийн дэмждэг two-decimal валют: 9,900₮ = 990000).
STRIPE_PRICE_ID=
# `stripe listen --forward-to localhost:3000/api/payments/stripe/webhook` эсвэл
# Dashboard → Webhooks-оос авна. Webhook-ийн HMAC гарын үсгийг шалгахад ашиглана —
# үүнгүй бол хэн ч "төлбөр төлөгдлөө" гэж хуурамч хүсэлт илгээж PRO эрх авч чадна.
# Сонсох event: invoice.paid, invoice.payment_failed, customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=
# Багцын нэр (Payment/Subscription бичлэгт хадгалагдана). Хоосон бол "МЭДРЭХ PRO".
STRIPE_PLAN_NAME=МЭДРЭХ PRO
# Энэ backend-ийн ГАДНААС харагдах хаяг. Гар утасны төлбөр дууссаны дараа
# Stripe үүн рүү буцаад, тэндээс `medreh://` deep link-ээр апп руу үсэргэдэг
# (Stripe нь success_url-д custom scheme хүлээж авдаггүй тул).
# Хоосон бол хүсэлтийн `Host` header-ээс автоматаар тодорхойлно — dev-д ихэвчлэн
# хангалттай. Reverse proxy-ийн ард ЗААВАЛ тодорхой бичнэ (жиш. https://api.medreh.mn).
PUBLIC_API_URL=
# Эмнэлгийн шинж чанартай эмзэг талбар (User.hearingProfile) DB-д ТОДООР бус,
# AES-256-GCM-ээр шифрлэгдэж хадгалагдана (см. src/common/crypto/field-encryption.ts).
# Тохируулаагүй бол dev-fallback (ИНСЕКЮР) түлхүүр ашиглана — production-д ЗААВАЛ
# тохируулна уу (жиш. `openssl rand -base64 48`). Энэ түлхүүрийг СОЛИХГҮЙ, ГЭЭГДЭХГҮЙ
# байх ёстой — гээгдвэл одоо байгаа шифрлэгдсэн hearingProfile мэдээлэл сэргээгдэхгүй.
HEARING_PROFILE_ENC_KEY=change_me

# --- S3 / MinIO (файл хадгалалт: дуу, ковер зураг, ноот) ---
# Локал хөгжүүлэлтэд эдгээрийг зааагүй бол доорх MinIO dev fallback утгууд
# ашиглагдана (см. backend/src/storage/storage.service.ts). Production-д
# S3_ACCESS_KEY/S3_SECRET_KEY заавал тохируулаагүй бол апп эхлэхгүй.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=medreh-media
S3_ACCESS_KEY=medreh_minio
S3_SECRET_KEY=medreh_minio_pw
S3_PUBLIC_URL=http://localhost:9000/medreh-media

# --- Алдааны хяналт (заавал биш) ---
# Хоосон орхивол Sentry идэвхжихгүй (dev/CI-д шаардлагагүй).
SENTRY_DSN=

# --- Jamendo (нээлттэй эрхийн дуу импортлох, заавал биш) ---
JAMENDO_CLIENT_ID=

# --- Google Sign-In (заавал биш, тохируулаагүй бол Google товч frontend дээр
# харагдахгүй, зөвхөн имэйл/нууц үг урсгал ажиллана) ---
# Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID
# (Web application), Authorized JavaScript origins-д frontend-ийн домэйныг
# (жиш. http://localhost:3001, production домэйн) нэмнэ. Client ID-г эндхийн
# GOOGLE_CLIENT_ID БОЛОН frontend/.env.example-ийн NEXT_PUBLIC_GOOGLE_CLIENT_ID
# хоёуланд ижил утгаар тохируулна (frontend клиент талд ID token авахад,
# backend audience шалгахад тус тус ашиглана).
GOOGLE_CLIENT_ID=412523725022-910q8qqrnfupo89cggcor5ejs03q4bla.apps.googleusercontent.com
